# Application
VITE_APP_NAME=v8 App Template
VITE_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Google Analytics 4 (set this in Vercel/hosting environment variables too)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Official social profile URLs. Empty values hide the respective footer icon.
# VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/your-page
VITE_SOCIAL_INSTAGRAM_URL==https://www.instagram.com/aptechlearningwhitefield/
# VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/your-company
# VITE_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@your-channel
VITE_WHATSAPP_URL=https://wa.me/917411333500
# Server
NODE_ENV=development
PORT=3000

# Features
VITE_ENABLE_SOURCE_MAPPING=true
VITE_ENABLE_SSR=true

# Development ToolsS
VITE_SHOW_DEV_TOOLS=false
# Optional: same as app id — local Docker preview sets SITE_ID; with vite envPrefix SITE_, client can link to /develop/{id}
# SITE_ID=

# Database (when needed)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Generated MySQL User Credentials (auto-managed by the system)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=root
# DB_NAME=Aptech

# External APIs (when needed)
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# Google Sheets enquiry storage (Vercel server-side environment variables)
# Share the destination spreadsheet with the service account email as Editor.
# GOOGLE_SHEETS_SPREADSHEET_ID=1nPn632sPZ4pX9_gTnBwETk7mAp-Ns0NNGZ2t5BiEMW4
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# GoDaddy Commerce (when skill-installed)
# Set by commerce-related skills when storefront features are added
# VITE_GODADDY_CLIENT_ID=<uuid-from-task-config>
# VITE_GODADDY_API_HOST=<hostname-from-GODADDY_API_BASE_URL>
# GODADDY_API_BASE_URL=https://api.dev-godaddy.com

# Authentication (when needed)
# JWT_SECRET=your-secret-here
# SESSION_SECRET=your-secret-here
